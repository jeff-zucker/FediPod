{
  "@context": [
    "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/components/context.jsonld",
    "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-css-gateway/^0.0.0/components/context.jsonld"
  ],
  "@graph": [
    {
      "comment": "The FediPod gateway/front handler. Set args_frontHost to the apex the front answers on (e.g. fedipod.net) and args_frontOrigin to its origin; pod subdomains fall through to CSS untouched. Field names carry the args_ prefix the generator produced from the constructor's options object.",
      "@id": "urn:fedipod:gateway:Handler",
      "@type": "FediPodGatewayHandler",
      "args_resourceStore": { "@id": "urn:solid-server:default:ResourceStore" },
      "args_frontHost": "fedipod.net",
      "args_frontOrigin": { "@id": "urn:solid-server:default:variable:baseUrl" },
      "args_directoryContainer": "/.internal/fedipod/directory/",
      "args_offersPods": false
    },
    {
      "comment": "Insert the handler into the routing waterfall just before the LDP catch-all, so it claims only the front routes and everything else stays normal CSS. OverrideListInsertBefore is available in componentsjs 5.x (which CSS 7 uses).",
      "@type": "Override",
      "overrideInstance": { "@id": "urn:solid-server:default:BaseHttpHandler" },
      "overrideSteps": [
        {
          "@type": "OverrideListInsertBefore",
          "overrideParameter": { "@id": "https://linkedsoftwaredependencies.org/bundles/npm/@solid/community-server/^7.0.0/dist/util/handlers/WaterfallHandler.jsonld#WaterfallHandler_handlers" },
          "overrideTarget": { "@id": "urn:solid-server:default:LdpHandler" },
          "overrideValue": { "@id": "urn:fedipod:gateway:Handler" }
        }
      ]
    }
  ]
}
