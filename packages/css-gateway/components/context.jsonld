    "FediPodGatewayHandler": "fpg:FediPodGatewayHandler",
    "resourceStore": { "@id": "fpg:FediPodGatewayHandler#resourceStore", "@type": "@id" },
    "frontHost": "fpg:FediPodGatewayHandler#frontHost",
    "frontOrigin": "fpg:FediPodGatewayHandler#frontOrigin",
    "gatewayWebId": "fpg:FediPodGatewayHandler#gatewayWebId",
    "offersPods": "fpg:FediPodGatewayHandler#offersPods",
    "directoryContainer": "fpg:FediPodGatewayHandler#directoryContainer",
    "signupPage": "fpg:FediPodGatewayHandler#signupPage"
  }
}
