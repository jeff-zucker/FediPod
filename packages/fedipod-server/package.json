{
  "name": "fedipod-server",
  "version": "0.31.0",
  "description": "The FediPod Server: a full ActivityPub server as a Community Solid Server component.",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "config",
    "README.md",
    "fedipod-server.svg"
  ],
  "peerDependencies": {
    "@solid/community-server": "^7.0.0"
  },
  "dependencies": {
    "fedipod": "^1.45.0"
  },
  "devDependencies": {
    "@fedify/fedify": "^2.3.4",
    "@solid/community-server": "^7.2.0",
    "@types/node": "^20.0.0",
    "componentsjs-generator": "^3.1.2",
    "n3": "^2.1.1",
    "rdflib": "^2.4.0",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "package.json": "npm:empty-npm-package@1.0.0",
    "package-lock.json": "npm:empty-npm-package@1.0.0"
  },
  "lsd:module": "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-server",
  "lsd:components": "dist/components/components.jsonld",
  "lsd:contexts": {
    "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-server/^0.0.0/components/context.jsonld": "dist/components/context.jsonld"
  },
  "lsd:importPaths": {
    "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-server/^0.0.0/components/": "dist/components/",
    "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-server/^0.0.0/config/": "config/",
    "https://linkedsoftwaredependencies.org/bundles/npm/fedipod-server/^0.0.0/dist/": "dist/"
  },
  "scripts": {
    "build": "tsc && npm run build:components",
    "build:components": "componentsjs-generator -s src -c dist/components -r fps",
    "pretest": "node scripts/link-fedipod.mjs",
    "test": "npm run build && node --test test/*.mjs",
    "pretest:e2e": "node scripts/link-fedipod.mjs",
    "test:e2e": "node test/e2e/live-agent.mjs",
    "pretest:e2e:suffix": "node scripts/link-fedipod.mjs",
    "test:e2e:suffix": "node test/e2e/live-suffix.mjs",
    "prepublishOnly": "npm test"
  }
}
