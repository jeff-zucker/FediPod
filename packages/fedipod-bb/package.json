{
  "name": "fedipod-bb",
  "version": "0.3.0",
  "description": "FediPod-BB: a forum website whose record lives on a Solid pod.",
  "license": "MIT",
  "type": "module",
  "main": "src/index.mjs",
  "exports": {
    ".": "./src/index.mjs",
    "./gateway": "./src/gateway.mjs",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "bin": {
    "fedipod-bb": "bin/fedipod-bb.mjs"
  },
  "files": [
    "bin",
    "src",
    "site",
    "README.md",
    "fep-draft.md"
  ],
  "scripts": {
    "pretest": "node scripts/link-fedipod.mjs",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "fedipod": "^1.43.0",
    "fediverse-session": "^0.2.1"
  }
}
