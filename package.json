{
  "name": "solid-activitypub",
  "version": "0.1.0",
  "description": "Standalone single-actor ActivityPub agent whose wire face, RDF truth and state all live on a Solid pod (CSS). Bundles a Phanpy UI and a Mastodon client-API facade.",
  "type": "module",
  "license": "MIT",
  "author": "Jeff Zucker",
  "bin": {
    "solid-activitypub": "bin/solid-activitypub.mjs"
  },
  "scripts": {
    "start": "node bin/solid-activitypub.mjs up",
    "install-service": "node bin/solid-activitypub.mjs install-service",
    "uninstall-service": "node bin/solid-activitypub.mjs uninstall-service",
    "test": "node claude/smoke-tests/agent-smoke.mjs && node scripts/verify-ui.mjs",
    "verify-ui": "node scripts/verify-ui.mjs",
    "audit": "npm audit --omit=dev",
    "agent": "node run-agent.mjs"
  },
  "dependencies": {
    "@fedify/fedify": "^2.3.4",
    "jose": "^6.2.8",
    "rdflib": "^2.4.0",
    "sanitize-html": "^2.17.6",
    "undici": "^6.28.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0"
  }
}
