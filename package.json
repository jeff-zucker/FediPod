{
  "name": "solid-activitypub",
  "version": "0.1.0",
  "description": "Standalone single-actor ActivityPub agent whose wire face, RDF truth and state all live on a Solid pod (CSS). Bundles a Phanpy UI and a Mastodon client-API facade.",
  "type": "module",
  "license": "MIT",
  "author": "Jeff Zucker",
  "bin": {
    "activitypod": "bin/activitypod.mjs"
  },
  "scripts": {
    "start": "node run-agent.mjs",
    "test": "node claude/smoke-tests/agent-smoke.mjs && node scripts/verify-ui.mjs",
    "verify-ui": "node scripts/verify-ui.mjs",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@fedify/fedify": "^1.9.0",
    "jose": "^5.10.0",
    "rdflib": "^2.4.0",
    "sanitize-html": "^2.17.6"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0"
  }
}
