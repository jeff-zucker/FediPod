{
  "name": "fedipod",
  "version": "0.8.0",
  "description": "Standalone single-actor ActivityPub agent whose wire face, RDF truth and state all live on a Solid pod (CSS). Bundles a Phanpy UI and a Mastodon client-API facade.",
  "type": "module",
  "license": "MIT",
  "author": "Jeff Zucker",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeff-zucker/FediPod.git"
  },
  "homepage": "https://github.com/jeff-zucker/FediPod#readme",
  "bugs": "https://github.com/jeff-zucker/FediPod/issues",
  "bin": {
    "fedipod": "bin/fedipod.mjs"
  },
  "files": [
    "bin",
    "lib",
    "web",
    "ui",
    "vendor",
    "phanpy/dist",
    "run-agent.mjs",
    "scripts",
    "gui.md",
    "cli.md",
    "groups.md",
    "architecture.svg"
  ],
  "scripts": {
    "start": "node bin/fedipod.mjs up",
    "install-service": "node bin/fedipod.mjs install-service",
    "uninstall-service": "node bin/fedipod.mjs uninstall-service",
    "prepublishOnly": "npm test",
    "test": "node claude/smoke-tests/agent-smoke.mjs && node claude/smoke-tests/front-hard-test.mjs && node scripts/verify-ui.mjs",
    "verify-ui": "node scripts/verify-ui.mjs",
    "audit": "npm audit --omit=dev",
    "agent": "node run-agent.mjs"
  },
  "dependencies": {
    "@fedify/fedify": "^2.3.4",
    "@netlify/blobs": "^10.7.13",
    "@solid/access-token-verifier": "^2.1.1",
    "jose": "^6.2.8",
    "node-forge": "^1.4.0",
    "rdflib": "^2.4.0",
    "sanitize-html": "^2.17.6",
    "undici": "^6.28.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "@opentelemetry/core": "^2.8.0",
    "package.json": "npm:empty-npm-package@1.0.0",
    "package-lock.json": "npm:empty-npm-package@1.0.0"
  }
}
